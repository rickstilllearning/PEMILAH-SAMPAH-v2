                badgeBg: 'bg-blue-100 text-blue-700 border border-blue-200',
                description: 'Kemasan minuman dan makanan kaleng dari bahan logam aluminium atau seng ringan.',
                pros: 'Dapat didaur ulang secara terus-menerus (infinite recycling) tanpa menurunkan kualitas bahan. Hemat energi hingga 95% dibanding membuat aluminium dari bijih mentah.',
                cons: 'Prosie ekstraksi awal bauksit merusak lingkungan. Jika dibuang begitu saja dapat menggenang air dan menjadi sarang nyamuk.',
                solution: 'Cuci bersih sisa minuman/makanan, pipihkan kaleng untuk menghemat tempat, dan jual ke Bank Sampah.',
                actions: ['Cuci Bersih', 'Pipihkan Kaleng', 'Bank Sampah']
            },
            {
                id: 'lampu-bohlam',
                name: 'Lampu Bohlam / TL (B3)',
                category: 'B3',
                degradeTime: 'Tidak Terurai',
                icon: 'fa-lightbulb',
                iconBg: 'bg-purple-100 text-purple-600',
                badgeBg: 'bg-rose-100 text-rose-700 border border-rose-200',
                description: 'Limbah lampu neon (TL), bohlam hemat energi (CFL), maupun LED bekas yang mengandung kaca dan uap merkuri beracun.',
                pros: 'Komponen kaca dan beberapa elemen logamnya dapat diproses kembali oleh fasilitas pengolahan limbah B3 berizin.',
                cons: 'Pecahan kaca berbahaya melukai petugas kebersihan. Gas uap merkuri di dalamnya berisiko terhirup dan merusak sistem saraf.',
                solution: 'Bungkus lampu bekas dengan kertas/bubble wrap agar tidak mudah pecah. Tandai "AWAS KACA & B3", serahkan ke penampungan sampah terpadu.',
                actions: ['Bungkus Aman', 'Beri Label B3', 'Fasilitas B3']
            },
            {
                id: 'kantong-plastik',
                name: 'Kantong Plastik / Kresek',
                category: 'Anorganik',
                degradeTime: '20 - 500 Tahun',
                icon: 'fa-bag-shopping',
                iconBg: 'bg-slate-200 text-slate-700',
                badgeBg: 'bg-blue-100 text-blue-700 border border-blue-200',
                description: 'Plastik belanja sekali pakai berbahan Low-Density Polyethylene (LDPE) atau HDPE tipis.',
                pros: 'Dapat dibuat kerajinan ecobrick atau diolah melalui proses pirolisis menjadi bahan bakar minyak sintetis.',
                cons: 'Sangat gampang terbang menyumbat saluran air memicu banjir, tertelan hewan laut, dan hancur menjadi partikel mikroplastik berbahaya.',
                solution: 'Hindari penggunaan kresek baru (Reduce). Manfaatkan kembali kresek lama (Reuse) atau padatkan ke dalam botol untuk membuat Ecobrick.',
                actions: ['Bawa Tas Sendiri', 'Buat Ecobrick', 'Reuse Plastik']
            }
        ];

        // Quiz Questions Data
        const quizData = [
            {
                question: "Mana di antara pilihan berikut yang termasuk dalam kategori sampah B3 (Berbahaya)?",
                options: ["Kulit Pisang", "Botol Kaca Minuman", "Baterai Bekas", "Kardus Bekas"],
                correct: 2,
                explanation: "Baterai bekas mengandung logam berat beracun seperti merkuri dan kadmium sehingga dikategorikan B3."
            },
            {
                question: "Apa dampak negatif utama dari menumpuk sampah organik di TPA secara sembarangan?",
                options: [
                    "Menghasilkan gas Metana pemicu efek rumah kaca",
                    "Tidak membusuk selamanya",
                    "Membuat tanah menjadi terlalu subur",
                    "Menghasilkan limbah radiasi"
                ],
                correct: 0,
                explanation: "Pembusukan anaerobik sampah organik di TPA menghasilkan gas metana yang memperparah pemanasan global."
            },
            {
                question: "Langkah terbaik untuk mengolah limbah kulit buah dan sisa sayuran di rumah adalah...",
                options: [
                    "Dibakar sampai habis",
                    "Diolah menjadi pupuk kompos atau biopori",
                    "Dibuang ke sungai",
                    "Dibungkus rapat plastik rapat-rapat"
                ],
                correct: 1,
                explanation: "Pengomposan mengubah limbah organik menjadi nutrisi penyuplai kesuburan tanah alami."
            }
        ];

        // Application State Variables
        let currentFilter = 'all';
        let activeWasteId = null;
        let currentQuizIndex = 0;
        let quizScore = 0;

        // DOM Elements
        const wasteGrid = document.getElementById('wasteGrid');
        const searchInput = document.getElementById('searchInput');
        const clearSearchBtn = document.getElementById('clearSearchBtn');
        const noResults = document.getElementById('noResults');
        const resultCount = document.getElementById('resultCount');
        
        // Detail DOM
        const detailPlaceholder = document.getElementById('detailPlaceholder');
        const detailContent = document.getElementById('detailContent');
        const detailTitle = document.getElementById('detailTitle');
        const detailBadge = document.getElementById('detailBadge');
        const detailTime = document.getElementById('detailTime');
        const detailDescription = document.getElementById('detailDescription');
        const detailPros = document.getElementById('detailPros');
        const detailCons = document.getElementById('detailCons');
        const detailSolution = document.getElementById('detailSolution');
        const detailIcon = document.getElementById('detailIcon');
        const detailIconContainer = document.getElementById('detailIconContainer');
        const detailActionSteps = document.getElementById('detailActionSteps');

        // Quiz DOM
        const quizQuestion = document.getElementById('quizQuestion');
        const quizOptions = document.getElementById('quizOptions');
        const quizFeedback = document.getElementById('quizFeedback');
        const nextQuizBtn = document.getElementById('nextQuizBtn');
        const quizCurrentNum = document.getElementById('quizCurrentNum');
        const quizTotalNum = document.getElementById('quizTotalNum');
        const quizScoreText = document.getElementById('quizScoreText');
        const quizContainer = document.getElementById('quizContainer');
        const quizResultScreen = document.getElementById('quizResultScreen');
        const finalScoreDisplay = document.getElementById('finalScoreDisplay');
        const restartQuizBtn = document.getElementById('restartQuizBtn');

        // Initialize Application
        window.addEventListener('DOMContentLoaded', () => {
            updateCategoryCounts();
            renderWasteList(wasteDatabase);
            initQuiz();
        });

        // Update Category Counts Badge
        function updateCategoryCounts() {
            document.getElementById('count-all').textContent = wasteDatabase.length;
            document.getElementById('count-organik').textContent = wasteDatabase.filter(w => w.category === 'Organik').length;
            document.getElementById('count-anorganik').textContent = wasteDatabase.filter(w => w.category === 'Anorganik').length;
            document.getElementById('count-b3').textContent = wasteDatabase.filter(w => w.category === 'B3').length;
        }

        // Render Waste List Grid
        function renderWasteList(items) {
            wasteGrid.innerHTML = '';
            resultCount.textContent = `${items.length} Item`;

            if (items.length === 0) {
                noResults.classList.remove('hidden');
                return;
            } else {
                noResults.classList.add('hidden');
            }

            items.forEach(item => {
                const isSelected = item.id === activeWasteId;
                const card = document.createElement('div');
                card.className = `p-4 rounded-2xl border transition-all cursor-pointer flex items-center justify-between ${
                    isSelected 
                    ? 'bg-emerald-50 border-emerald-500 shadow-sm ring-2 ring-emerald-500/20' 
                    : 'bg-white border-slate-200/80 hover:border-emerald-300 hover:shadow-sm'
                }`;

                card.onclick = () => selectWasteItem(item);

                card.innerHTML = `
                    <div class="flex items-center space-x-3.5">
                        <div class="w-11 h-11 rounded-xl flex items-center justify-center text-lg ${item.iconBg}">
                            <i class="fa-solid ${item.icon}"></i>
                        </div>
                        <div>
                            <h4 class="text-sm font-bold text-slate-800 line-clamp-1">${item.name}</h4>
                            <span class="text-[11px] font-semibold ${getCategoryTextColor(item.category)}">
                                ${item.category}
                            </span>
                        </div>
                    </div>
                    <div class="flex items-center text-slate-400 text-xs font-medium">
                        <i class="fa-solid fa-chevron-right text-xs"></i>
                    </div>
                `;
                wasteGrid.appendChild(card);
            });
        }

        function getCategoryTextColor(category) {
            switch(category) {
                case 'Organik': return 'text-emerald-600';
                case 'Anorganik': return 'text-blue-600';
                case 'B3': return 'text-rose-600';
                default: return 'text-slate-500';
            }
        }

        // Select and Display Detailed Information
        function selectWasteItem(item) {
            activeWasteId = item.id;
            
            // Re-render list to reflect selected active border
            filterAndSearch();

            // Populate Detail Panel
            detailPlaceholder.classList.add('hidden');
            detailContent.classList.remove('hidden');

            detailTitle.textContent = item.name;
            detailBadge.textContent = item.category;
            detailBadge.className = `inline-block text-xs font-bold px-2.5 py-0.5 rounded-md uppercase tracking-wider mb-1 ${item.badgeBg}`;
            detailTime.textContent = `Estimasi Urai: ${item.degradeTime}`;
            
            detailDescription.textContent = item.description;
            detailPros.textContent = item.pros;
            detailCons.textContent = item.cons;
            detailSolution.textContent = item.solution;

            detailIcon.className = `fa-solid ${item.icon}`;
            detailIconContainer.className = `w-14 h-14 rounded-2xl flex items-center justify-center text-2xl shadow-inner ${item.iconBg}`;

            // Actions Steps Pill
            detailActionSteps.innerHTML = '';
            item.actions.forEach(act => {
                const pill = document.createElement('div');
                pill.className = 'bg-slate-800/80 border border-slate-700 text-emerald-300 px-2.5 py-1.5 rounded-lg text-center font-medium flex items-center justify-center gap-1.5';
                pill.innerHTML = `<i class="fa-solid fa-check text-[10px]"></i> ${act}`;
                detailActionSteps.appendChild(pill);
            });
        }

        // Search & Filter Handler
        function filterAndSearch() {
            const query = searchInput.value.toLowerCase().trim();
            
            const filtered = wasteDatabase.filter(item => {
                const matchesCategory = (currentFilter === 'all') || (item.category === currentFilter);
                const matchesSearch = item.name.toLowerCase().includes(query) || 
                                      item.description.toLowerCase().includes(query) ||
                                      item.category.toLowerCase().includes(query);
                return matchesCategory && matchesSearch;
            });

            renderWasteList(filtered);
        }

        // Event Listeners for Filters
        document.getElementById('categoryFilters').addEventListener('click', (e) => {
            const btn = e.target.closest('.filter-btn');
            if (!btn) return;

            document.querySelectorAll('.filter-btn').forEach(b => {
                b.className = 'filter-btn px-4 py-2 rounded-xl text-sm font-semibold transition-all bg-white text-slate-600 border border-slate-200 hover:border-emerald-300';
            });

            btn.className = 'filter-btn px-4 py-2 rounded-xl text-sm font-semibold transition-all bg-emerald-600 text-white shadow-sm';
            currentFilter = btn.dataset.category;
            filterAndSearch();
        });

        // Search Input Event
        searchInput.addEventListener('input', (e) => {
            if (e.target.value.length > 0) {
                clearSearchBtn.classList.remove('hidden');
            } else {
                clearSearchBtn.classList.add('hidden');
            }
            filterAndSearch();
        });

        clearSearchBtn.addEventListener('click', () => {
            searchInput.value = '';
            clearSearchBtn.classList.add('hidden');
            filterAndSearch();
        });

        // ------------------ QUIZ ENGINE ------------------ //
        function initQuiz() {
            currentQuizIndex = 0;
            quizScore = 0;
            quizTotalNum.textContent = quizData.length;
            quizResultScreen.classList.add('hidden');
            quizContainer.classList.remove('hidden');
            loadQuestion();
        }

        function loadQuestion() {
            quizFeedback.classList.add('hidden');
            nextQuizBtn.classList.add('hidden');
            
            const q = quizData[currentQuizIndex];
            quizCurrentNum.textContent = currentQuizIndex + 1;
            quizQuestion.textContent = q.question;
            quizScoreText.textContent = `Skor: ${quizScore}`;

            quizOptions.innerHTML = '';
            q.options.forEach((opt, idx) => {
                const btn = document.createElement('button');
                btn.className = 'w-full text-left p-3.5 bg-white border border-slate-200 hover:border-emerald-500 rounded-xl font-medium text-sm text-slate-700 transition flex items-center justify-between';
                btn.innerHTML = `<span>${opt}</span> <i class="fa-regular fa-circle text-slate-300"></i>`;
                btn.onclick = () => checkAnswer(idx, btn);
                quizOptions.appendChild(btn);
            });
        }

        function checkAnswer(selectedIndex, clickedBtn) {
            const q = quizData[currentQuizIndex];
            const buttons = quizOptions.querySelectorAll('button');

            // Disable all buttons
            buttons.forEach(b => b.disabled = true);

            if (selectedIndex === q.correct) {
                quizScore += 33.3; // Approx 100 for 3 questions
                clickedBtn.className = 'w-full text-left p-3.5 bg-emerald-50 border-2 border-emerald-500 rounded-xl font-bold text-sm text-emerald-800 flex items-center justify-between';
                clickedBtn.innerHTML = `<span>${q.options[selectedIndex]}</span> <i class="fa-solid fa-circle-check text-emerald-600"></i>`;
                
                quizFeedback.className = 'p-4 rounded-xl text-sm font-medium mb-4 bg-emerald-100 text-emerald-900 border border-emerald-200';
                quizFeedback.innerHTML = `<i class="fa-solid fa-check mr-1.5"></i> <strong>Benar!</strong> ${q.explanation}`;
            } else {
                clickedBtn.className = 'w-full text-left p-3.5 bg-rose-50 border-2 border-rose-500 rounded-xl font-bold text-sm text-rose-800 flex items-center justify-between';
                clickedBtn.innerHTML = `<span>${q.options[selectedIndex]}</span> <i class="fa-solid fa-circle-xmark text-rose-600"></i>`;
                
                // Highlight correct answer
                buttons[q.correct].className = 'w-full text-left p-3.5 bg-emerald-50 border border-emerald-400 rounded-xl font-semibold text-sm text-emerald-800 flex items-center justify-between';

                quizFeedback.className = 'p-4 rounded-xl text-sm font-medium mb-4 bg-rose-100 text-rose-900 border border-rose-200';
                quizFeedback.innerHTML = `<i class="fa-solid fa-xmark mr-1.5"></i> <strong>Kurang Tepat.</strong> ${q.explanation}`;
            }

            quizFeedback.classList.remove('hidden');
            nextQuizBtn.classList.remove('hidden');
        }

        nextQuizBtn.addEventListener('click', () => {
            currentQuizIndex++;
            if (currentQuizIndex < quizData.length) {
                loadQuestion();
            } else {
                showQuizResults();
            }
        });

        function showQuizResults() {
            quizContainer.classList.add('hidden');
            quizResultScreen.classList.remove('hidden');
            const totalScore = Math.min(100, Math.round(quizScore));
            finalScoreDisplay.textContent = `${totalScore} / 100`;
        }

        restartQuizBtn.addEventListener('click', initQuiz);
    </script>
</body>
</html>

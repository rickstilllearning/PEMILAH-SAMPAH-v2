<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EcoTrack - Aplikasi Pengenal & Edukasi Sampah</title>
    <!-- Tailwind CSS CDN -->
